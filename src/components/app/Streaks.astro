---
// Decorative "hyperspace" streaks in the gap below a row. Positions from docs/swonmac.pen:
// [left % of the content width, top px within the gap, width %, height px].
interface Props {
  set: 'hud' | 'title';
}

const sets = {
  hud: [
    [49.2, 27, 4.7, 1],
    [22.1, 19, 21.4, 2],
    [71.7, 49, 25.6, 1],
    [32.7, 48, 22.5, 1],
    [56.7, 14, 23.2, 2],
    [66.7, 19, 6.2, 1],
    [32.6, 50, 11.3, 1],
    [27.4, 40, 5.9, 1],
    [14.8, 43, 6.5, 1],
    [75.1, 26, 14.6, 2],
  ],
  title: [
    [47, 36, 11.6, 1],
    [56, 15, 25.9, 1],
    [44.8, 31, 5.2, 1],
    [49.4, 27, 26.7, 1],
    [41.6, 19, 21.8, 1],
    [34.4, 31, 13.6, 2],
  ],
} as const;
---

<div class="pointer-events-none absolute inset-x-0 top-full hidden h-14 lg:block" aria-hidden="true">
  {
    sets[Astro.props.set].map(([left, top, width, height]) => (
      <span
        class="absolute bg-linear-to-r from-transparent to-accent opacity-80 light:opacity-60"
        style={`left:${left}%;top:${top}px;width:${width}%;height:${height}px`}
      />
    ))
  }
</div>
