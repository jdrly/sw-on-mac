export type IconName = keyof typeof paths;

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className = 'size-4' } = Astro.props;
---

<svg
  class:list={['shrink-0', className]}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {paths[name].map((d) => <path d={d} />)}
</svg>
