---
// #releases: both apps on one timeline, newest first. Left: title, the All/SWTOR/SWGL filter
// (the page's only JS besides the theme toggle) and the current stable builds; right: the log.
import { apps, type AppId } from '../data/apps';
import { links } from '../data/site';
import { formatDate, type Release } from '../lib/releases';
import ReleaseEntry from './releases/ReleaseEntry.astro';

interface Props {
  releases: Release[];
  latest: Record<AppId, Release | undefined>;
}

const { releases, latest } = Astro.props;
const appIds = Object.keys(apps) as AppId[];
const releasesUrl: Record<AppId, string> = { swtor: links.swtorReleases, swgl: links.swglReleases };
// Literal class names, so Tailwind sees them: show only under this app's filter / hide under the other's.
const onlyUnder: Record<AppId, string> = {
  swtor: 'group-data-[filter=swtor]/rel:block',
  swgl: 'group-data-[filter=swgl]/rel:block',
};
const hiddenUnderOther: Record<AppId, string> = {
  swtor: 'group-data-[filter=swgl]/rel:hidden',
  swgl: 'group-data-[filter=swtor]/rel:hidden',
};
const mono = 'font-mono text-[11px] tracking-[2px] uppercase';
---

<section id="releases" data-filter="all" aria-labelledby="releases-title" class="group/rel border-t border-line">
  <div class="mx-auto max-w-[1440px] px-5 pt-14 pb-[72px] sm:px-10 lg:pb-[140px] xl:px-24">
    <div class="flex items-center justify-between gap-6 font-mono text-[10px] tracking-[2px] text-fg-3 uppercase sm:text-xs" aria-hidden="true">
      <span class="text-fg-2">// Sector 04 — Flight log</span>
      <span class="hidden md:inline">Rel.log &nbsp;·&nbsp; {appIds.length} vessels &nbsp;·&nbsp; stable channel only</span>
      <span class="hidden lg:inline">41°N 3.072 &nbsp;/&nbsp; NAV 0x04</span>
    </div>

    <div class="mt-5 grid gap-9 lg:mt-[72px] lg:grid-cols-[minmax(0,340px)_minmax(0,1fr)] lg:gap-14 xl:grid-cols-[400px_minmax(0,1fr)] xl:gap-24">
      <!-- Left: intro, filter, current builds (sticky on wide screens) -->
      <div class="releases-aside flex flex-col gap-5 lg:gap-10 lg:self-start">
        <div class="flex flex-col gap-5 lg:gap-6">
          <h2
            id="releases-title"
            class="font-display text-[46px] leading-none font-extrabold tracking-[-1.5px] text-fg lg:text-[68px] lg:leading-[0.92] lg:tracking-[-3px] xl:text-[80px]"
          >
            <span class="lg:block">Release</span> log
          </h2>
          <p class="text-base leading-[1.6] text-fg-2">
            Both apps on one timeline, newest first. The latest build of each app is open; older notes are
            folded away. Pre-release -dev builds never make it onto this log.
          </p>
        </div>

        <!-- Shown by the script; without JS every release shows and there's nothing to filter. -->
        <div data-filter-control hidden>
          <p id="releases-filter-label" class:list={[mono, 'mb-3 text-fg-3 max-lg:sr-only']}>Filter transmissions</p>
          <div role="group" aria-labelledby="releases-filter-label" class="flex gap-1 border border-line-strong p-1">
            {
              (['all', ...appIds] as const).map((id) => (
                <button
                  type="button"
                  data-value={id}
                  aria-pressed={id === 'all' ? 'true' : 'false'}
                  class:list={[
                    id !== 'all' && `app-${id}`,
                    'flex flex-1 cursor-pointer items-center justify-center gap-2 py-3 font-mono text-xs font-semibold tracking-[2px] text-fg-2 uppercase transition-colors',
                    'hover:bg-surface hover:text-fg aria-pressed:bg-fg aria-pressed:text-bg',
                    'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-fg',
                  ]}
                >
                  {id !== 'all' && <span class="size-2 bg-accent" aria-hidden="true" />}
                  {id === 'all' ? 'All' : apps[id].short}
                </button>
              ))
            }
          </div>
        </div>

        <div>
          <h3 class:list={[mono, 'border-line pb-3 text-fg-3 max-lg:sr-only lg:border-b']}>Current stable builds</h3>
          <dl class="grid grid-cols-2 border-y border-line lg:grid-cols-1 lg:border-t-0">
            {
              appIds.map((id, i) => {
                const r = latest[id];
                return (
                  <div
                    class:list={[
                      `app-${id}`,
                      'grid content-start gap-1.5 py-4 lg:grid-cols-[1fr_auto] lg:items-end lg:gap-x-4 lg:border-b lg:border-line lg:py-5',
                      i === 0 ? 'border-r border-line pr-4 lg:border-r-0 lg:pr-0' : 'pl-4 lg:pl-0',
                    ]}
                  >
                    <dt class:list={[mono, 'text-[10px] font-semibold text-accent sm:text-[11px] lg:col-start-1 lg:row-start-1']}>
                      {apps[id].name}
                    </dt>
                    <dd class="font-display text-[30px] leading-none font-bold tracking-[-1px] text-fg lg:col-start-2 lg:row-span-2 lg:row-start-1 lg:text-[44px]">
                      {r ? (
                        <a
                          href={`#${r.id}`}
                          class="hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
                        >
                          <span class="sr-only">Version </span>
                          {r.version}
                        </a>
                      ) : (
                        <span class="text-fg-3">—</span>
                      )}
                    </dd>
                    <dd class:list={[mono, 'text-[10px] text-fg-3 sm:text-[11px] lg:col-start-1 lg:row-start-2']}>
                      {r ? <time datetime={r.publishedAt.toISOString()}>{formatDate(r.publishedAt)}</time> : 'No stable build yet'}
                    </dd>
                  </div>
                );
              })
            }
          </dl>
        </div>
      </div>

      <!-- Right: the timeline -->
      <div class="min-w-0">
        {
          releases.length > 0 ? (
            <ol aria-label="Releases, newest first">
              {releases.map((r) => (
                <ReleaseEntry release={r} isLatest={latest[r.app]?.id === r.id} />
              ))}
              {appIds
                .filter((id) => !latest[id])
                .map((id) => (
                  <li class:list={[`app-${id}`, 'hidden', onlyUnder[id]]}>
                    <p class="border border-dashed border-line-strong px-6 py-8 text-fg-2">
                      No stable release of {apps[id].name} yet.
                    </p>
                  </li>
                ))}
            </ol>
          ) : (
            <div class="border border-dashed border-line-strong px-6 py-10 sm:px-10">
              <p class:list={[mono, 'text-fg-3']}>// No transmissions yet</p>
              <p class="mt-3 text-fg-2">
                No stable releases yet. They'll show up here, with their notes, as soon as they're out on GitHub.
              </p>
            </div>
          )
        }

        <div class:list={[mono, 'flex flex-wrap items-center justify-center gap-x-8 gap-y-3 pt-6 text-xs font-semibold text-fg sm:justify-start sm:pl-11']}>
          {
            appIds.map((id) => (
              <a
                href={releasesUrl[id]}
                class:list={[
                  `app-${id}`,
                  hiddenUnderOther[id],
                  'group/link inline-flex items-center gap-2.5 hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent',
                ]}
              >
                <span class="size-2 bg-accent" aria-hidden="true" />
                All {apps[id].short} releases on GitHub
                <svg
                  aria-hidden="true"
                  class="size-4 transition-transform group-hover/link:translate-x-0.5 group-hover/link:-translate-y-0.5"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M7 7h10v10M7 17 17 7" />
                </svg>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Sticky only where the column fits the viewport. */
  @media (min-width: 64rem) and (min-height: 44rem) {
    .releases-aside {
      position: sticky;
      top: 6rem;
    }
  }
</style>

<script>
  const section = document.getElementById('releases');
  const control = section?.querySelector<HTMLElement>('[data-filter-control]');
  if (section && control) {
    control.hidden = false;
    control.addEventListener('click', (event) => {
      const button = (event.target as Element).closest<HTMLButtonElement>('button[data-value]');
      if (!button) return;
      section.dataset.filter = button.dataset.value;
      for (const b of control.querySelectorAll('button')) b.setAttribute('aria-pressed', String(b === button));
    });
  }
</script>
