---
import Starfield from './Starfield.astro';
import Warp from './hero/Warp.astro';
import { apps, type AppId } from '../data/apps';
import { formatDate, type Release } from '../lib/releases';

interface Props {
  latest: Record<AppId, Release | undefined>;
}

const { latest } = Astro.props;
const appIds = Object.keys(apps) as AppId[];
const focus = 'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-fg';

// The hyperspace burst around the vanishing point, generated at build time (deterministic).
function rng(a: number) {
  return () => {
    a |= 0;
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const rand = rng(4242);
const r1 = (n: number) => Math.round(n * 10) / 10;
const streaks = Array.from({ length: 140 }, () => {
  const a = rand() * Math.PI * 2;
  const r0 = 30 + rand() ** 1.4 * 520;
  const len = 30 + rand() * (80 + r0 * 1.3);
  const t = rand();
  return {
    x1: r1(Math.cos(a) * r0),
    y1: r1(Math.sin(a) * r0),
    x2: r1(Math.cos(a) * (r0 + len)),
    y2: r1(Math.sin(a) * (r0 + len)),
    tint: t < 0.08 ? 'swtor' : t < 0.18 ? 'swgl' : 'fg',
    o: r1(0.25 + rand() * 0.6),
    w: rand() < 0.15 ? 1.5 : 1,
  };
});
const rings = [90, 190, 320, 480, 680];
---

<section id="download" aria-labelledby="hero-title" data-warp-root class="relative isolate -mt-16 overflow-hidden pt-16 lg:-mt-18 lg:pt-18">
  <!-- Backdrop: grid, stars, and the hyperspace burst around the jump point -->
  <div class="hero-backdrop pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="hero-grid absolute inset-0 opacity-55"></div>
    <Starfield seed={7} density={6} />
    <Warp />

    <div data-warp-anchor class="burst absolute top-[290px] left-[80%] sm:top-[150px] md:top-[310px] md:left-[84%] lg:top-[330px] lg:left-[min(calc(50%+460px),calc(100%-190px))]">
      <svg class="absolute -top-[1200px] -left-[1200px] size-[2400px] overflow-visible" viewBox="-1200 -1200 2400 2400" focusable="false">
        <defs>
          <radialGradient id="hero-glow-swgl">
            <stop offset="0" stop-color="var(--c-swgl)" stop-opacity="0.18" />
            <stop offset="1" stop-color="var(--c-swgl)" stop-opacity="0" />
          </radialGradient>
          <radialGradient id="hero-glow-swtor">
            <stop offset="0" stop-color="var(--c-swtor)" stop-opacity="0.11" />
            <stop offset="1" stop-color="var(--c-swtor)" stop-opacity="0" />
          </radialGradient>
          {
            streaks.map((s, i) => (
              <linearGradient id={`hero-s${i}`} gradientUnits="userSpaceOnUse" x1={s.x1} y1={s.y1} x2={s.x2} y2={s.y2}>
                <stop offset="0" stop-color={`var(--c-${s.tint === 'fg' ? 'fg' : s.tint})`} stop-opacity="0" />
                <stop offset="1" stop-color={`var(--c-${s.tint === 'fg' ? 'fg' : s.tint})`} />
              </linearGradient>
            ))
          }
        </defs>
        <circle r="420" fill="url(#hero-glow-swgl)" />
        <circle cx="-180" cy="180" r="380" fill="url(#hero-glow-swtor)" />
        <g fill="none" stroke="var(--c-border-strong)" opacity="0.8">
          {rings.map((r) => <circle r={r} />)}
        </g>
        <g stroke="var(--c-border-strong)" opacity="0.6">
          <line x1="-760" x2="760" />
          <line y1="-1200" y2="1200" />
        </g>
        <g class="streaks" stroke-linecap="round">
          {streaks.map((s, i) => <line x1={s.x1} y1={s.y1} x2={s.x2} y2={s.y2} stroke={`url(#hero-s${i})`} stroke-width={s.w} opacity={s.o} />)}
        </g>
        <rect x="-14" y="-14" width="28" height="28" fill="none" stroke="var(--c-fg-2)" />
        <circle r="3" class="core" />
      </svg>
      <div class="absolute top-[24px] -left-[44px] font-mono lg:top-[10px] lg:left-[14px] text-[10px] leading-4 tracking-[0.2em] whitespace-nowrap">
        <p class="text-fg-2">VP-01<span class="hidden lg:inline"> // JUMP POINT</span></p>
        <p class="text-swgl">D3D9 → METAL</p>
      </div>
    </div>

    <div class="fade-left absolute inset-0"></div>
    <div class="fade-bottom absolute inset-0"></div>
  </div>

  <div class="mx-auto max-w-[1440px] px-5 pt-7 pb-14 lg:px-12 lg:pt-14 lg:pb-18">
    <!-- HUD row -->
    <div class="flex items-center gap-3 font-mono text-[11px] tracking-[0.23em] whitespace-nowrap lg:gap-4" aria-hidden="true">
      <span class="text-fg-2">// SECTOR 00<span class="hidden lg:inline"> · HYPERSPACE ROUTE</span></span>
      <span class="h-px min-w-6 flex-1 bg-line-strong"></span>
      <span class="text-fg-3 lg:hidden">HYPERSPACE ROUTE</span>
      <span class="hidden text-fg-3 lg:inline">37.3349° N &nbsp;·&nbsp; 122.0090° W &nbsp;·&nbsp; ARM64</span>
    </div>

    <h1
      id="hero-title"
      class="mt-9 font-display text-[clamp(2.6rem,13.4vw,3.6rem)] leading-[1.05] tracking-[-0.025em] text-fg sm:text-[clamp(3.6rem,2.2rem+4.2vw,5.5rem)] lg:mt-14"
    >
      <span class="block font-extrabold">Star Wars games</span>
      <span class="flex items-center gap-6">
        <span class="font-extralight">on Apple Silicon</span>
        <span class="arch hidden xl:flex" aria-hidden="true"></span>
      </span>
      <span class="flex items-center gap-4 sm:gap-6">
        <span class="font-extrabold">Macs.</span>
        <span class="arch flex xl:hidden" aria-hidden="true"></span>
      </span>
    </h1>

    <div class="mt-6 flex flex-col gap-5 lg:mt-8 lg:flex-row lg:items-end lg:gap-12">
      <p class="max-w-[560px] text-base leading-[1.55] text-fg-2 lg:text-lg lg:leading-normal">
        Two free apps for Apple Silicon Macs. SWTOR on Mac speeds up the official SWTOR Mac app by sending its Direct3D 9
        straight to Metal. SWGL on Mac runs SWG Legends, which has no Mac version of its own.
      </p>
      <ul class="flex max-w-[260px] flex-wrap pl-px font-mono text-[10px] tracking-[0.2em] text-fg-2 sm:max-w-none" aria-label="At a glance">
        {
          ['FREE', 'OPEN SOURCE · ZLIB', 'SIGNED & NOTARIZED'].map((t) => (
            <li class="-mt-px -ml-px border border-line-strong bg-bg/60 px-3 py-[7px] whitespace-nowrap">{t}</li>
          ))
        }
      </ul>
    </div>

    <!-- Download console -->
    <div class="relative mt-11 border border-line-strong bg-bg-raised/90 backdrop-blur-xl lg:mt-14">
      <span class="absolute -top-[9px] left-5 z-10 bg-bg px-2 py-0.5 font-mono text-[10px] leading-[13px] tracking-[0.2em] text-fg lg:left-6" aria-hidden="true">
        // SECTOR 01 · DOWNLOAD
      </span>
      <span class="bracket -top-px -left-px border-t-2 border-l-2" aria-hidden="true"></span>
      <span class="bracket -top-px -right-px border-t-2 border-r-2" aria-hidden="true"></span>
      <span class="bracket -bottom-px -left-px border-b-2 border-l-2" aria-hidden="true"></span>
      <span class="bracket -right-px -bottom-px border-r-2 border-b-2" aria-hidden="true"></span>

      <div class="grid grid-cols-1 xl:grid-cols-2">
        {
          appIds.map((id, i) => {
            const app = apps[id];
            const release = latest[id];
            const suffix = app.name.replace(app.short, '').trim();
            return (
              <article
                class:list={[`app-${id} flex flex-col`, i > 0 && 'border-line-strong xl:border-l']}
                aria-labelledby={`card-${id}`}
              >
                <div class="h-[3px] bg-accent" aria-hidden="true" />
                <div class="flex items-center justify-between gap-4 border-b border-line px-5 py-3.5 font-mono text-[10px] leading-[13px] tracking-[0.25em] sm:px-8">
                  <span class="text-fg-3" aria-hidden="true">
                    {String.fromCharCode(65 + i)} // <span class="hidden sm:inline">TARGET {String(i + 1).padStart(2, '0')} · </span>#
                    {app.short}
                  </span>
                  {release ? (
                    <span class="flex items-center gap-2 text-accent">
                      <span class="size-1.5 bg-accent" aria-hidden="true" />
                      STABLE · {release.version}
                    </span>
                  ) : (
                    <span class="flex items-center gap-2 text-fg-3">
                      <span class="size-1.5 border border-fg-3" aria-hidden="true" />
                      IN DEVELOPMENT
                    </span>
                  )}
                </div>

                <div class="flex flex-1 flex-col gap-3 px-5 pt-6 pb-6 sm:gap-3.5 sm:px-8 sm:pt-8 sm:pb-7">
                  <h2
                    id={`card-${id}`}
                    class="font-display text-[clamp(1.6rem,7.6vw,1.875rem)] leading-tight tracking-[-0.015em] text-fg sm:text-[34px]"
                  >
                    <span class="font-bold">{app.short}</span> <span class="font-extralight text-fg-2">{suffix}</span>
                  </h2>
                  <p class="text-base leading-normal text-fg-2">{app.tagline}</p>

                  <div class="mt-auto flex flex-col gap-2.5 pt-1.5 sm:flex-row sm:flex-wrap sm:items-center sm:gap-x-6 sm:gap-y-3 sm:pt-2.5">
                    {release ? (
                      <a
                        href={release.dmgUrl}
                        class:list={[
                          'inline-flex h-13 items-center justify-center gap-3 bg-accent px-5.5 text-[15px] font-semibold whitespace-nowrap text-on-accent transition-[filter] hover:brightness-110 max-[379px]:gap-2.5 max-[379px]:px-3 max-[379px]:text-sm',
                          focus,
                        ]}
                        aria-label={`Download ${app.name} ${release.version}, released ${formatDate(release.publishedAt)} (.dmg)`}
                      >
                        <svg class="size-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <path d="M12 17V3M6 11l6 6 6-6M19 21H5" />
                        </svg>
                        <span>
                          Download {release.version}
                          <span class="mx-1.5" aria-hidden="true">·</span>
                          <time datetime={release.publishedAt.toISOString()}>{formatDate(release.publishedAt)}</time>
                        </span>
                      </a>
                    ) : (
                      <span
                        class="inline-flex h-13 cursor-not-allowed items-center justify-center gap-3 border border-dashed border-line-strong px-5.5 text-[15px] font-semibold text-fg-3"
                        aria-disabled="true"
                      >
                        <svg class="size-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" />
                        </svg>
                        Coming soon
                      </span>
                    )}
                    <a
                      href={`#${id}`}
                      class:list={[
                        'inline-flex h-12 items-center justify-center border border-line-strong text-[15px] font-medium text-fg transition-colors hover:border-fg sm:h-auto sm:border-0 sm:border-b sm:py-1 sm:text-sm',
                        focus,
                      ]}
                    >
                      Requirements &amp; install&nbsp;<span aria-hidden="true">↓</span>
                    </a>
                  </div>
                </div>

                <ul
                  class="flex flex-wrap gap-x-4 gap-y-2 border-t border-line px-5 py-3.5 font-mono text-[10px] leading-[13px] tracking-[0.2em] text-fg-3 uppercase sm:gap-x-5 sm:px-8 sm:py-3"
                  aria-label={`${app.name} at a glance`}
                >
                  {app.chips.map((c) => (
                    <li class:list={[c.startsWith('macOS') && 'normal-case']}>{c}</li>
                  ))}
                </ul>
              </article>
            );
          })
        }
      </div>
    </div>
  </div>
</section>

<style>
  .hero-grid {
    background-image: linear-gradient(to right, var(--c-border) 1px, transparent 1px);
    background-size: 175px 100%;
    background-position: 20px 0;
  }
  @media (min-width: 64rem) {
    .hero-grid {
      background-size: 96px 100%;
      background-position: calc(50% - 672px) 0;
    }
  }
  .core {
    fill: var(--c-fg);
  }
  .fade-left {
    background: linear-gradient(
      to right,
      color-mix(in srgb, var(--c-bg) 70%, transparent),
      color-mix(in srgb, var(--c-bg) 35%, transparent) 50%,
      transparent 80%
    );
  }
  @media (min-width: 64rem) {
    .fade-left {
      background: linear-gradient(
        to right,
        color-mix(in srgb, var(--c-bg) 95%, transparent),
        color-mix(in srgb, var(--c-bg) 70%, transparent) 45%,
        transparent 72%
      );
    }
  }
  .fade-bottom {
    background: linear-gradient(
      to bottom,
      transparent 45%,
      color-mix(in srgb, var(--c-bg) 90%, transparent) 80%,
      var(--c-bg)
    );
  }
  .streaks {
    transition: opacity 0.6s ease-out;
  }
  :global([data-theme='light']) .streaks {
    opacity: 0.55;
  }
  /* The canvas warp field (hero/Warp.astro) has taken over from the static rays. */
  section[data-warp='on'] .streaks {
    opacity: 0;
  }
  .bracket {
    position: absolute;
    z-index: 1;
    width: 16px;
    height: 16px;
    border-color: var(--c-fg);
  }
  .arch::before {
    content: 'ARCH  ARM64\A GPU   METAL\A OS    macOS 26+';
    white-space: pre;
  }
  .arch {
    border-left: 1px solid var(--c-border-strong);
    padding-left: 0.875rem;
    font-family: var(--font-jetbrains-mono);
    font-size: 10px;
    font-weight: 400;
    line-height: 19px;
    letter-spacing: 0.2em;
    color: var(--c-fg-2);
  }
  @media (max-width: 39.999rem) {
    .arch {
      font-size: 9px;
      line-height: 17px;
      padding-left: 0.75rem;
    }
  }
</style>
