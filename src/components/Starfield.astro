---
// Decorative star field: an inline SVG generated at build time, deterministic from `seed`.
// Fills its positioned parent at any size: positions are percentages, sizes are pixels, so
// nothing stretches. No JS, no images. Colours follow the theme tokens.
interface Props {
  class?: string;
  /** Same seed, same sky */
  seed?: number;
  /** Roughly stars per 100 000 px² of a 1440×900 area (default 5) */
  density?: number;
}

const { class: className = '', seed = 1, density = 5 } = Astro.props;

// mulberry32: tiny, deterministic PRNG
function rng(a: number) {
  return () => {
    a |= 0;
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const rand = rng(seed * 9973 + 17);
const pct = (n: number) => `${Math.round(n * 1000) / 10}%`;
const r2 = (n: number) => Math.round(n * 100) / 100;
const tint = () => {
  const t = rand();
  return t < 0.06 ? 'swtor' : t < 0.12 ? 'swgl' : 'fg';
};

const count = Math.max(8, Math.round(((1440 * 900) / 100_000) * density));
const stars = Array.from({ length: count }, () => {
  const big = rand() < 0.1;
  return {
    x: pct(rand()),
    y: pct(rand()),
    r: r2(big ? 1.1 + rand() * 0.6 : 0.5 + rand() * 0.45),
    o: r2(big ? 0.55 + rand() * 0.3 : 0.15 + rand() * 0.5),
    tint: tint(),
    twinkle: big && rand() < 0.7,
    delay: r2(rand() * 7),
  };
});

// A few faint horizontal hyperspace streaks
const streaks = Array.from({ length: Math.max(2, Math.round(count / 30)) }, () => ({
  x: pct(rand() * 0.9),
  y: pct(0.04 + rand() * 0.92),
  w: Math.round(60 + rand() * 160),
  o: r2(0.2 + rand() * 0.25),
  tint: tint(),
}));
const gid = `sf-${seed}`;
---

<div class:list={['starfield pointer-events-none absolute inset-0 overflow-hidden', className]} aria-hidden="true">
  <svg class="absolute inset-0 h-full w-full" focusable="false">
    <defs>
      {
        (['fg', 'swtor', 'swgl'] as const).map((t) => (
          <linearGradient id={`${gid}-${t}`}>
            <stop offset="0" stop-color={`var(--c-${t === 'fg' ? 'fg-2' : t})`} stop-opacity="0" />
            <stop offset="1" stop-color={`var(--c-${t === 'fg' ? 'fg-2' : t})`} />
          </linearGradient>
        ))
      }
    </defs>
    {streaks.map((s) => <rect x={s.x} y={s.y} width={s.w} height="1" fill={`url(#${gid}-${s.tint})`} opacity={s.o} />)}
    {
      stars.map((s) => (
        <circle
          cx={s.x}
          cy={s.y}
          r={s.r}
          class:list={[s.twinkle && 'twinkle', `t-${s.tint}`]}
          style={`--o:${s.o};--d:-${s.delay}s`}
        />
      ))
    }
  </svg>
</div>

<style>
  circle {
    opacity: var(--o);
  }
  .t-fg {
    fill: var(--c-fg-2);
  }
  .t-swtor {
    fill: var(--c-swtor);
  }
  .t-swgl {
    fill: var(--c-swgl);
  }
  @media (prefers-reduced-motion: no-preference) {
    .twinkle {
      animation: sf-twinkle 7s ease-in-out var(--d) infinite;
    }
  }
  @keyframes sf-twinkle {
    50% {
      opacity: calc(var(--o) * 0.25);
    }
  }
</style>
