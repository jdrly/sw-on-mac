                                                  "textGrowth": "fixed-width",
                                                  "width": "fill_container",
                                                  "content": "Better logs for stutter reports",
                                                  "lineHeight": 1.65,
                                                  "fontFamily": "$font-body",
                                                  "fontSize": 15,
                                                  "fontWeight": "600"
                                                },
                                                {
                                                  "type": "text",
