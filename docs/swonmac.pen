                                                  "textGrowth": "fixed-width",
                                                  "width": "fill_container",
                                                  "content": "A sidebar lists the sections (Graphics, Game, Keyboard, Play Button, Updates, Troubleshooting), as in System Settings. The window fits on any screen, can be resized, and opens on the section you used last.",
                                                  "lineHeight": 1.65,
