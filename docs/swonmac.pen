                                                  "name": "p",
                                                  "fill": "$text-secondary",
                                                  "textGrowth": "fixed-width",
                                                  "width": "fill_container",
                                                  "content": "With Settings > Troubleshooting > Debug Logging on, the log records frame times, slow frames and shader compiles once a second, and Collect Logs… adds a short summary of your last game session. Leave it off unless you're reporting a problem.",
                                                  "lineHeight": 1.65,
                                                  "fontFamily": "$font-body",
                                                  "fontSize": 15,
