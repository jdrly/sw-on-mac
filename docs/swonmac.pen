                                      "type": "text",
                                      "id": "U4oSIH",
                                      "name": "p",
                                      "fill": "$text-secondary",
                                      "textGrowth": "fixed-width",
                                      "width": "fill_container",
                                      "content": "The compiled-shader cache is kept, so there should be no extra stutter after the update. If the first few minutes in a new area do stutter, the cache is being rebuilt; that settles by itself.",
                                      "lineHeight": 1.65,
                                      "fontFamily": "$font-body",
                                      "fontSize": 15,
